{
	"appId": "com.codigomaster.iptv",
	"appName": "Codigo Master IPTV",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#09090b",
			"showSpinner": true,
			"spinnerColor": "#6366f1"
		}
	},
	"android": {
		"allowMixedContent": true
	}
}
